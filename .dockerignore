# Keep the build context lean. The Dockerfile only COPYs specific paths
# (pyproject.toml, uv.lock, src); catalog cache is synced at runtime.

# Virtualenv / build outputs
.venv/
build/
dist/
*.egg-info/

# VCS
.git/
.gitignore

# Caches
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Tests, specs, scripts, dev harness (not needed at runtime)
tests/
specs/
scripts/
sample.txt
architecture.md

# Catalog assets stay in the repo for local/offline tooling only — never baked
# into the runtime image (synced from Connect at boot + periodically).
contracts/
artifacts/

# Secrets & local run artifacts
.env
*.log
*.progress.log

# OS / IDE
.DS_Store
Thumbs.db
.claude/
.python-version
